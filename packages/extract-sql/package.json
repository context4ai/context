{
  "name": "@c4a/extract-sql",
  "description": "Dialect-bound lightweight SQL evidence adapter for Context",
  "version": "0.7.5",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/context4ai/context.git",
    "directory": "packages/extract-sql"
  },
  "keywords": [
    "sql",
    "database",
    "migration",
    "code-analysis"
  ],
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "rm -rf dist && bun run ../build.ts src/index.ts && bun run ../writeLibraryDistPackage.ts . && cp ../../LICENSE dist/LICENSE",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "eslint src"
  },
  "dependencies": {
    "@c4a/core": "workspace:*",
    "node-sql-parser": "^5.4.0"
  }
}
