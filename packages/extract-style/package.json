{
  "name": "@c4a/extract-style",
  "description": "Lightweight CSS and SCSS evidence adapter for Context",
  "version": "0.7.0-preview.2",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/context4ai/context.git",
    "directory": "packages/extract-style"
  },
  "keywords": [
    "css",
    "scss",
    "styles",
    "code-analysis"
  ],
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "rm -rf dist && bun run ../build.ts src/index.ts && bun run ../writeLibraryDistPackage.ts . && cp ../../LICENSE dist/LICENSE",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "eslint src"
  },
  "dependencies": {
    "@c4a/core": "workspace:*",
    "postcss": "^8.5.26",
    "postcss-scss": "^4.0.9",
    "postcss-selector-parser": "^7.1.5",
    "postcss-value-parser": "^4.2.0"
  }
}
