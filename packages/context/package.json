{
  "name": "@c4a/context",
  "description": "Context SDK — project-local configuration and workspace primitives",
  "version": "0.6.3",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/context4ai/context.git",
    "directory": "packages/context"
  },
  "keywords": [
    "context",
    "sdk",
    "knowledge",
    "workspace"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "templates",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "build": "rm -rf dist && bun run ../build.ts src/index.ts && tsc -p tsconfig.build.json && cp ../../LICENSE dist/LICENSE",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "eslint src"
  },
  "dependencies": {
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  }
}
