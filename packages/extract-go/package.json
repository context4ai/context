{
  "name": "@c4a/extract-go",
  "description": "Go extraction plugin and structural index for Context",
  "version": "0.6.4",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/context4ai/context.git",
    "directory": "packages/extract-go"
  },
  "keywords": [
    "go",
    "golang",
    "tree-sitter",
    "code-analysis",
    "extraction"
  ],
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "rm -rf dist && bun run ../build.ts src/index.ts && bun run ../writeLibraryDistPackage.ts . && cp ../../LICENSE dist/LICENSE",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "eslint src"
  },
  "dependencies": {
    "tree-sitter": "^0.25.0",
    "tree-sitter-go": "^0.25.0"
  },
  "devDependencies": {
    "@c4a/core": "workspace:*",
    "@c4a/extract": "workspace:*"
  }
}
