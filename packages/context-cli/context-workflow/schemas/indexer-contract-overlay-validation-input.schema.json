{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "context.indexer.contract-overlay-validation-input/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "project_ref",
    "overlay",
    "base_contract",
    "operator_contract",
    "provider_integrity",
    "input_digest"
  ],
  "properties": {
    "protocol": { "const": "context.indexer.contract-overlay-validation-input/v1" },
    "project_ref": { "type": "string", "minLength": 1 },
    "overlay": {
      "type": "object",
      "required": ["protocol", "overlay_digest"],
      "properties": {
        "protocol": { "const": "context.indexer.contract-overlay/v1" },
        "overlay_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "base_contract": {
      "type": "object",
      "required": ["protocol", "contract_digest"],
      "properties": {
        "protocol": { "const": "context.indexer.profile-contract/v1" },
        "contract_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "operator_contract": {
      "type": "object",
      "required": ["protocol", "contract_digest"],
      "properties": {
        "protocol": { "const": "context.indexer.operator-contract/v1" },
        "contract_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "provider_integrity": { "$ref": "#/$defs/digest" },
    "input_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
