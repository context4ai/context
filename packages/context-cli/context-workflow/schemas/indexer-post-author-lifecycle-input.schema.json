{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "context.indexer.post-author-lifecycle-input/v1",
  "oneOf": [
    {
      "type": "object",
      "required": ["protocol", "requirement_set_digest", "selections", "manifest_layers", "current_profiles"],
      "properties": {
        "protocol": { "const": "context.indexer.effective-composer-resolution-input/v1" },
        "requirement_set_digest": { "$ref": "#/$defs/digest" },
        "selections": { "type": "array", "items": { "type": "object" } },
        "manifest_layers": { "type": "array", "items": { "type": "object" } },
        "current_profiles": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["protocol", "requirement_set_digest", "effective_composer_set", "author_workset_digest", "validator_contract_digest", "current_profile_binding_digest", "allowed_target_refs", "accepted_input_view_digest"],
      "properties": {
        "protocol": { "const": "context.indexer.post-author-workset-build-input/v1" },
        "requirement_set_digest": { "$ref": "#/$defs/digest" },
        "effective_composer_set": { "type": "object" },
        "author_workset_digest": { "$ref": "#/$defs/digest" },
        "validator_contract_digest": { "$ref": "#/$defs/digest" },
        "current_profile_binding_digest": { "$ref": "#/$defs/digest" },
        "allowed_target_refs": { "type": "array", "items": { "type": "string" } },
        "accepted_input_view_digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["protocol", "requirement_set_digest", "plan", "ledger", "composer_ref"],
      "properties": {
        "protocol": { "const": "context.indexer.post-author-run-start-input/v1" },
        "requirement_set_digest": { "$ref": "#/$defs/digest" },
        "plan": { "type": "object" },
        "ledger": { "type": "object" },
        "composer_ref": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["protocol", "requirement_set_digest", "plan", "ledger", "composer_ref", "result", "validator_contract_digest"],
      "properties": {
        "protocol": { "const": "context.indexer.post-author-run-accept-input/v1" },
        "requirement_set_digest": { "$ref": "#/$defs/digest" },
        "plan": { "type": "object" },
        "ledger": { "type": "object" },
        "composer_ref": { "type": "string", "minLength": 1 },
        "result": { "type": "object" },
        "validator_contract_digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["protocol", "requirement_set_digest", "plan", "ledger", "composer_ref", "reason_code", "dependency_digests"],
      "properties": {
        "protocol": { "const": "context.indexer.post-author-run-fail-input/v1" },
        "requirement_set_digest": { "$ref": "#/$defs/digest" },
        "plan": { "type": "object" },
        "ledger": { "type": "object" },
        "composer_ref": { "type": "string", "minLength": 1 },
        "reason_code": { "type": "string", "minLength": 1 },
        "dependency_digests": { "type": "array", "items": { "$ref": "#/$defs/digest" } }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["protocol", "requirement_set_digest", "plan", "ledger", "effective_composer_set", "validator_contract_digest", "accepted_input_view_digest"],
      "properties": {
        "protocol": { "enum": ["context.indexer.post-author-observation-input/v1", "context.indexer.post-author-compose-input/v1"] },
        "requirement_set_digest": { "$ref": "#/$defs/digest" },
        "plan": { "type": "object" },
        "ledger": { "type": "object" },
        "effective_composer_set": { "type": "object" },
        "validator_contract_digest": { "$ref": "#/$defs/digest" },
        "accepted_input_view_digest": { "$ref": "#/$defs/digest" },
        "current_envelope": { "type": "object" }
      },
      "additionalProperties": false
    }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
