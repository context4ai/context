{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "context.indexer.overlay-question-amendment/v1",
  "type": "object",
  "required": ["protocol", "amendment_digest"],
  "properties": {
    "protocol": { "const": "context.indexer.overlay-question-amendment/v1" },
    "amendment_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
