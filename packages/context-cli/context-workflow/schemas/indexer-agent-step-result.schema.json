{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "context.indexer.agent-step-result/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "input_digest",
    "instruction_payload_digest",
    "run_result",
    "execution_receipt",
    "stable_result_digest"
  ],
  "properties": {
    "protocol": { "const": "context.indexer.agent-step-result/v1" },
    "input_digest": { "$ref": "#/$defs/digest" },
    "instruction_payload_digest": { "$ref": "#/$defs/digest" },
    "run_result": { "$ref": "#/$defs/runResult" },
    "execution_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "adapter_version", "execution_id", "receipt_digest"],
      "properties": {
        "adapter": { "type": "string", "minLength": 1 },
        "adapter_version": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "execution_id": { "type": "string", "minLength": 1 },
        "receipt_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "stable_result_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._/-]*$"
    },
    "canonicalRef": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]*:[A-Za-z0-9][A-Za-z0-9._~:/#@+-]*$"
    },
    "providerLayerRef": {
      "allOf": [
        { "$ref": "#/$defs/canonicalRef" },
        { "not": { "pattern": "#composer:" } }
      ]
    },
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)[^\\u0000]+$"
    },
    "jsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/jsonValue" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      ]
    },
    "subjectKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "namespace", "kind", "local_key"],
      "properties": {
        "protocol": { "const": "context.subject-key/v1" },
        "namespace": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "local_key": { "type": "string", "minLength": 1 }
      }
    },
    "inventoryMemberKind": {
      "enum": [
        "project",
        "document",
        "entry",
        "route",
        "component",
        "service",
        "method",
        "example",
        "protocol-method",
        "handler",
        "event-branch",
        "timer-branch",
        "downstream-callsite",
        "store",
        "state-transition"
      ]
    },
    "runResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "operation",
        "consumed_input_view_digest",
        "workset_read_receipt_digests",
        "result"
      ],
      "properties": {
        "protocol": { "const": "context.indexer.run-result/v1" },
        "operation": { "const": "main-index" },
        "consumed_input_view_digest": {
          "$ref": "#/$defs/digest",
          "description": "The run request composition_input.view_digest. The authorized workset View is bound separately by its CLI-issued read receipt."
        },
        "workset_read_receipt_digests": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/digest" },
          "description": "Bound mechanically by Context from CLI-issued workset read receipts after Agent execution."
        },
        "result": {
          "oneOf": [
            { "$ref": "#/$defs/partitionMainResult" },
            { "$ref": "#/$defs/authorMainResult" }
          ]
        }
      }
    },
    "partitionMainResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "stage", "workset_digest", "execution_request_digest", "result"],
      "properties": {
        "protocol": { "const": "context.indexer.main-result/v1" },
        "stage": { "const": "partition" },
        "workset_digest": { "$ref": "#/$defs/digest" },
        "execution_request_digest": { "$ref": "#/$defs/digest" },
        "result": { "$ref": "#/$defs/partitionPlan" }
      }
    },
    "authorMainResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "stage", "workset_digest", "execution_request_digest", "result"],
      "properties": {
        "protocol": { "const": "context.indexer.main-result/v1" },
        "stage": { "const": "author" },
        "workset_digest": { "$ref": "#/$defs/digest" },
        "execution_request_digest": { "$ref": "#/$defs/digest" },
        "result": { "$ref": "#/$defs/artifactResult" }
      }
    },
    "partitionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "partition_workset_digest",
        "indexer_id",
        "indexer_fingerprint",
        "requirement_digest",
        "subject_key_schema_digest",
        "source_scope_digest",
        "source_refs",
        "module_ref",
        "partition_subject_key",
        "parent_scope_ref",
        "inventory_digest",
        "question_target_inventory_digest"
      ],
      "properties": {
        "partition_workset_digest": { "$ref": "#/$defs/digest" },
        "indexer_id": { "$ref": "#/$defs/id" },
        "indexer_fingerprint": { "$ref": "#/$defs/digest" },
        "requirement_digest": { "$ref": "#/$defs/digest" },
        "subject_key_schema_digest": { "$ref": "#/$defs/digest" },
        "source_scope_digest": { "$ref": "#/$defs/digest" },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/canonicalRef" }
        },
        "module_ref": {
          "oneOf": [
            { "$ref": "#/$defs/canonicalRef" },
            { "type": "null" }
          ]
        },
        "partition_subject_key": { "$ref": "#/$defs/subjectKey" },
        "parent_scope_ref": { "$ref": "#/$defs/canonicalRef" },
        "inventory_digest": { "$ref": "#/$defs/digest" },
        "question_target_inventory_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "partitionStrategy": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "indexer_id", "strategy_id", "implementation_digest"],
          "properties": {
            "kind": { "const": "project-indexer" },
            "indexer_id": { "$ref": "#/$defs/id" },
            "strategy_id": { "$ref": "#/$defs/id" },
            "implementation_digest": { "$ref": "#/$defs/digest" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "strategy_id", "implementation_digest"],
          "properties": {
            "kind": { "const": "cli-builtin" },
            "strategy_id": { "$ref": "#/$defs/id" },
            "implementation_digest": { "$ref": "#/$defs/digest" }
          }
        }
      ]
    },
    "partitionQuestionTargetBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_ref", "role"],
      "properties": {
        "target_ref": { "$ref": "#/$defs/canonicalRef" },
        "role": { "enum": ["primary-carrier", "enricher"] }
      }
    },
    "partitionGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group_key",
        "subject_key",
        "subject_intent",
        "logical_unit_ref",
        "label",
        "reader_question_refs",
        "question_target_bindings",
        "member_ids"
      ],
      "properties": {
        "group_key": { "type": "string", "minLength": 1 },
        "subject_key": { "$ref": "#/$defs/subjectKey" },
        "subject_intent": { "enum": ["primary", "enrich-or-independent"] },
        "logical_unit_ref": { "$ref": "#/$defs/canonicalRef" },
        "label": { "type": "string", "minLength": 1 },
        "reader_question_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/canonicalRef" }
        },
        "question_target_bindings": {
          "type": "array",
          "items": { "$ref": "#/$defs/partitionQuestionTargetBinding" }
        },
        "member_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/canonicalRef" }
        }
      }
    },
    "partitionMemberDisposition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["member_id", "member_kind", "inventory_disposition", "group_key"],
          "properties": {
            "member_id": { "$ref": "#/$defs/canonicalRef" },
            "member_kind": { "$ref": "#/$defs/inventoryMemberKind" },
            "inventory_disposition": { "const": "owned" },
            "group_key": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["member_id", "member_kind", "inventory_disposition", "reason_code"],
          "properties": {
            "member_id": { "$ref": "#/$defs/canonicalRef" },
            "member_kind": { "$ref": "#/$defs/inventoryMemberKind" },
            "inventory_disposition": { "const": "excluded-with-reason" },
            "reason_code": { "$ref": "#/$defs/id" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["member_id", "member_kind", "inventory_disposition", "missing_capabilities"],
          "properties": {
            "member_id": { "$ref": "#/$defs/canonicalRef" },
            "member_kind": { "$ref": "#/$defs/inventoryMemberKind" },
            "inventory_disposition": { "const": "unsupported" },
            "missing_capabilities": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/id" }
            }
          }
        }
      ]
    },
    "partitionFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "unassigned_member_ids"],
      "properties": {
        "code": {
          "enum": [
            "unsupported-domain",
            "no-stable-axis",
            "insufficient-identity-facts",
            "invalid-input",
            "strategy-failed"
          ]
        },
        "message": { "type": "string", "minLength": 1 },
        "unassigned_member_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/canonicalRef" }
        },
        "missing_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "missing_source_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/canonicalRef" }
        }
      }
    },
    "completePartitionPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "binding",
        "strategy_ref",
        "strategy_digest",
        "unit_type",
        "partition_axis",
        "reader_question_refs",
        "groups",
        "member_dispositions",
        "canonical_hash",
        "status",
        "failure"
      ],
      "properties": {
        "protocol": { "const": "context.indexer.partition-plan/v1" },
        "binding": { "$ref": "#/$defs/partitionBinding" },
        "strategy_ref": { "$ref": "#/$defs/partitionStrategy" },
        "strategy_digest": { "$ref": "#/$defs/digest" },
        "unit_type": { "$ref": "#/$defs/id" },
        "partition_axis": { "$ref": "#/$defs/id" },
        "reader_question_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/canonicalRef" }
        },
        "groups": {
          "type": "array",
          "items": { "$ref": "#/$defs/partitionGroup" }
        },
        "member_dispositions": {
          "type": "array",
          "items": { "$ref": "#/$defs/partitionMemberDisposition" }
        },
        "canonical_hash": { "$ref": "#/$defs/digest" },
        "status": { "const": "complete" },
        "failure": { "type": "null" }
      }
    },
    "failedPartitionPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "binding",
        "strategy_ref",
        "strategy_digest",
        "unit_type",
        "partition_axis",
        "reader_question_refs",
        "groups",
        "member_dispositions",
        "canonical_hash",
        "status",
        "failure"
      ],
      "properties": {
        "protocol": { "const": "context.indexer.partition-plan/v1" },
        "binding": { "$ref": "#/$defs/partitionBinding" },
        "strategy_ref": { "$ref": "#/$defs/partitionStrategy" },
        "strategy_digest": { "$ref": "#/$defs/digest" },
        "unit_type": { "$ref": "#/$defs/id" },
        "partition_axis": { "$ref": "#/$defs/id" },
        "reader_question_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/canonicalRef" }
        },
        "groups": {
          "type": "array",
          "items": { "$ref": "#/$defs/partitionGroup" }
        },
        "member_dispositions": {
          "type": "array",
          "items": { "$ref": "#/$defs/partitionMemberDisposition" }
        },
        "canonical_hash": { "$ref": "#/$defs/digest" },
        "status": { "const": "failed" },
        "failure": { "$ref": "#/$defs/partitionFailure" }
      }
    },
    "partitionPlan": {
      "oneOf": [
        { "$ref": "#/$defs/completePartitionPlan" },
        { "$ref": "#/$defs/failedPartitionPlan" }
      ]
    },
    "targetResolutionDisposition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["query_ref", "disposition", "target_subject_key", "target_node_ref"],
          "properties": {
            "query_ref": { "$ref": "#/$defs/digest" },
            "disposition": { "const": "reuse-existing" },
            "target_subject_key": { "$ref": "#/$defs/subjectKey" },
            "target_node_ref": { "$ref": "#/$defs/canonicalRef" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["query_ref", "disposition", "subject_key", "reason_code", "evidence_refs"],
          "properties": {
            "query_ref": { "$ref": "#/$defs/digest" },
            "disposition": { "const": "create-independent" },
            "subject_key": { "$ref": "#/$defs/subjectKey" },
            "reason_code": { "$ref": "#/$defs/id" },
            "evidence_refs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/canonicalRef" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["query_ref", "disposition", "missing_facts", "source_hints"],
          "properties": {
            "query_ref": { "$ref": "#/$defs/digest" },
            "disposition": { "const": "request-material" },
            "missing_facts": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/id" }
            },
            "source_hints": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/canonicalRef" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["query_ref", "disposition", "missing_capabilities"],
          "properties": {
            "query_ref": { "$ref": "#/$defs/digest" },
            "disposition": { "const": "unsupported" },
            "missing_capabilities": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/id" }
            }
          }
        }
      ]
    },
    "logicalUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group_key", "subject_key", "logical_unit_ref", "target_resolution_dispositions"],
      "properties": {
        "group_key": { "type": "string", "minLength": 1 },
        "subject_key": { "$ref": "#/$defs/subjectKey" },
        "logical_unit_ref": { "$ref": "#/$defs/canonicalRef" },
        "target_resolution_dispositions": {
          "type": "array",
          "items": { "$ref": "#/$defs/targetResolutionDisposition" }
        }
      }
    },
    "evidenceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_ref",
        "kind",
        "source_ref",
        "module_ref",
        "locator",
        "content_digest",
        "coverage_tier",
        "binding_digest"
      ],
      "properties": {
        "evidence_ref": { "$ref": "#/$defs/canonicalRef" },
        "kind": {
          "enum": [
            "code",
            "contract",
            "configuration",
            "documentation",
            "runbook",
            "decision-record",
            "test-result",
            "runtime-observation",
            "tool-snapshot"
          ]
        },
        "source_ref": { "$ref": "#/$defs/canonicalRef" },
        "module_ref": {
          "oneOf": [
            { "$ref": "#/$defs/canonicalRef" },
            { "type": "null" }
          ]
        },
        "locator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "start_line", "end_line"],
          "properties": {
            "path": { "$ref": "#/$defs/portablePath" },
            "start_line": { "type": "integer", "minimum": 1 },
            "end_line": { "type": "integer", "minimum": 1 }
          }
        },
        "content_digest": { "$ref": "#/$defs/digest" },
        "coverage_tier": { "enum": ["ast-catalog", "lightweight-evidence"] },
        "binding_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "artifactFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_ref", "fact_kind", "subject_key", "value", "evidence_refs"],
      "properties": {
        "fact_ref": { "$ref": "#/$defs/canonicalRef" },
        "fact_kind": { "$ref": "#/$defs/id" },
        "subject_key": { "$ref": "#/$defs/subjectKey" },
        "value": { "$ref": "#/$defs/jsonValue" },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/canonicalRef" }
        }
      }
    },
    "contentBlock": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["block_id", "layer", "renderer", "fact_refs"],
          "properties": {
            "block_id": { "$ref": "#/$defs/id" },
            "layer": { "const": "deterministic-block" },
            "renderer": { "enum": ["bullet-list", "key-value-table", "json-code-block"] },
            "fact_refs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/canonicalRef" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["block_id", "layer", "markdown", "evidence_refs"],
          "properties": {
            "block_id": { "$ref": "#/$defs/id" },
            "layer": { "const": "semantic-prose" },
            "markdown": { "type": "string", "minLength": 1 },
            "evidence_refs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/canonicalRef" }
            }
          }
        }
      ]
    },
    "sectionProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section_key", "owner_indexer_id", "document_kind", "reader_goal", "artifact_kind"],
      "properties": {
        "section_key": { "$ref": "#/$defs/id" },
        "owner_indexer_id": { "$ref": "#/$defs/id" },
        "document_kind": { "$ref": "#/$defs/id" },
        "reader_goal": { "$ref": "#/$defs/id" },
        "artifact_kind": { "$ref": "#/$defs/id" }
      }
    },
    "artifact": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifact_id",
            "artifact_kind",
            "artifact_policy_variant",
            "representation",
            "template_id",
            "variables",
            "section_projections"
          ],
          "properties": {
            "artifact_id": { "$ref": "#/$defs/id" },
            "artifact_kind": { "$ref": "#/$defs/id" },
            "artifact_policy_variant": { "$ref": "#/$defs/id" },
            "representation": { "const": "template" },
            "template_id": { "$ref": "#/$defs/id" },
            "variables": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["value", "fact_refs", "evidence_refs"],
                "properties": {
                  "value": { "$ref": "#/$defs/jsonValue" },
                  "fact_refs": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": { "$ref": "#/$defs/canonicalRef" }
                  },
                  "evidence_refs": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": { "$ref": "#/$defs/canonicalRef" }
                  }
                }
              }
            },
            "section_projections": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/sectionProjection" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifact_id",
            "artifact_kind",
            "artifact_policy_variant",
            "representation",
            "sections"
          ],
          "properties": {
            "artifact_id": { "$ref": "#/$defs/id" },
            "artifact_kind": { "$ref": "#/$defs/id" },
            "artifact_policy_variant": { "$ref": "#/$defs/id" },
            "representation": { "const": "sections" },
            "sections": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "section_key",
                  "owner_indexer_id",
                  "document_kind",
                  "reader_goal",
                  "artifact_kind",
                  "blocks"
                ],
                "properties": {
                  "section_key": { "$ref": "#/$defs/id" },
                  "owner_indexer_id": { "$ref": "#/$defs/id" },
                  "document_kind": { "$ref": "#/$defs/id" },
                  "reader_goal": { "$ref": "#/$defs/id" },
                  "artifact_kind": { "$ref": "#/$defs/id" },
                  "blocks": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/$defs/contentBlock" }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "artifactBundleEntry": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact_id", "artifact_kind", "purpose", "reader_question_refs", "evidence_refs"],
          "properties": {
            "artifact_id": { "$ref": "#/$defs/id" },
            "artifact_kind": { "$ref": "#/$defs/id" },
            "purpose": { "enum": ["required", "discretionary"] },
            "reader_question_refs": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/canonicalRef" }
            },
