{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "context.indexer.current-action-input/v2",
  "$comment": "Generated from current maintenance action definitions. New production uses the schemas in its stage directory. Runtime validation checks the active action, actual references and write conflicts.",
  "oneOf": [
    {
      "$ref": "#/$defs/sourceUpdate"
    },
    {
      "$ref": "#/$defs/approvedRevision"
    },
    {
      "$ref": "#/$defs/structureReview"
    }
  ],
  "$defs": {
    "sourceUpdate": {
      "type": "object",
      "properties": {
        "stage": {
          "type": "string",
          "const": "source-update"
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "instruction": {
                "type": "string",
                "minLength": 1
              },
              "supporting_sources": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            },
            "required": [
              "path"
            ],
            "additionalProperties": false
          }
        },
        "scope_summary": {
          "type": "string",
          "minLength": 1
        },
        "new_topics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "source_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "instruction": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "path",
              "title",
              "source_refs",
              "instruction"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "stage",
        "decisions",
        "scope_summary",
        "new_topics"
      ],
      "additionalProperties": false
    },
    "approvedRevision": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "stage": {
              "type": "string",
              "const": "approved-revision"
            },
            "markdown": {
              "type": "string",
              "minLength": 1
            },
            "sections": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "section_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "references": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "source_ref": {
                          "type": "string",
                          "minLength": 1
                        },
                        "locator": {
                          "type": "object",
                          "properties": {
                            "path": {
                              "type": "string"
                            },
                            "start_line": {
                              "type": "integer",
                              "minimum": 1
                            },
                            "end_line": {
                              "type": "integer",
                              "minimum": 1
                            }
                          },
                          "required": [
                            "path",
                            "start_line",
                            "end_line"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "source_ref",
                        "locator"
                      ],
                      "additionalProperties": false
                    },
                    "maxItems": 3
                  }
                },
                "required": [
                  "section_id",
                  "references"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "stage",
            "markdown"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "stage": {
              "type": "string",
              "const": "approved-revision"
            },
            "sections": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "section_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "content": {
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "markdown": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "markdown"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "program": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "program"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    },
                    "minItems": 1
                  },
                  "references": {
                    "$ref": "#/$defs/approvedRevision/anyOf/0/properties/sections/items/properties/references"
                  }
                },
                "required": [
                  "section_id"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "required": [
            "stage",
            "sections"
          ],
          "additionalProperties": false
        }
      ]
    },
    "structureReview": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "stage": {
              "type": "string",
              "const": "structure-review"
            },
            "knowledge_map": {
              "type": "object",
              "properties": {
                "expected_revision": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "upsert": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "key": {
                        "type": "string",
                        "minLength": 1
                      },
                      "parent": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "title": {
                        "type": "string",
                        "minLength": 1
                      },
                      "order": {
                        "type": "number",
                        "default": 0
                      },
                      "target": {
                        "type": "object",
                        "properties": {
                          "artifact_ref": {
                            "type": "string",
                            "minLength": 1
                          },
                          "section_key": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "artifact_ref"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "key",
                      "parent",
                      "title"
                    ],
                    "additionalProperties": false
                  },
                  "default": []
                },
                "remove": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "default": []
                }
              },
              "required": [
                "expected_revision"
              ],
              "additionalProperties": false
            },
            "decision": {
              "type": "string",
              "const": "approved"
            },
            "feedback": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "stage",
            "decision"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "stage": {
              "$ref": "#/$defs/structureReview/anyOf/0/properties/stage"
            },
            "knowledge_map": {
              "$ref": "#/$defs/structureReview/anyOf/0/properties/knowledge_map"
            },
            "decision": {
              "type": "string",
              "const": "exclude-obsolete"
            },
            "feedback": {
              "$ref": "#/$defs/structureReview/anyOf/0/properties/feedback"
            }
          },
          "required": [
            "stage",
            "decision"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "stage": {
              "$ref": "#/$defs/structureReview/anyOf/0/properties/stage"
            },
            "knowledge_map": {
              "$ref": "#/$defs/structureReview/anyOf/0/properties/knowledge_map"
            },
            "decision": {
              "type": "string",
              "const": "request-adjustment"
            },
            "feedback": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "stage",
            "decision",
            "feedback"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
