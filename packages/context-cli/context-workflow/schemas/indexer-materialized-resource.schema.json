{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "context.indexer.materialized-resource/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "request_digest",
    "provider_fingerprint",
    "resources",
    "payload_digest",
    "context_receipt"
  ],
  "properties": {
    "protocol": { "const": "context.indexer.materialized-resource/v1" },
    "request_digest": { "$ref": "#/$defs/digest" },
    "provider_fingerprint": { "$ref": "#/$defs/digest" },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "resource_ref", "digest", "content"],
        "properties": {
          "kind": {
            "enum": [
              "provider",
              "template",
              "composer",
              "customization-append"
            ]
          },
          "resource_ref": { "type": "string", "minLength": 1 },
          "digest": { "$ref": "#/$defs/digest" },
          "content": { "type": "string" }
        }
      }
    },
    "payload_digest": { "$ref": "#/$defs/digest" },
    "context_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "staged_receipt_digest",
        "provider_source_receipt_digest",
        "customization_fingerprint",
        "receipt_digest"
      ],
      "properties": {
        "staged_receipt_digest": { "$ref": "#/$defs/digest" },
        "provider_source_receipt_digest": { "$ref": "#/$defs/digest" },
        "customization_fingerprint": { "$ref": "#/$defs/digest" },
        "receipt_digest": { "$ref": "#/$defs/digest" }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
