{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "context.indexer.material-gap-lifecycle-output/v1",
  "type": "object",
  "required": ["protocol", "graph_outcome"],
  "properties": {
    "protocol": {
      "enum": [
        "context.indexer.material-gap-checkpoint-result/v1",
        "context.indexer.material-gap-audit-result/v1",
        "context.indexer.material-gap-evaluation-result/v1",
        "context.indexer.material-answer-actualization-result/v1",
        "context.indexer.close-approved-knowledge-result/v1"
      ]
    },
    "graph_outcome": { "enum": ["completed", "partial", "blocked", "failed", "unverified"] }
  },
  "additionalProperties": true
}
