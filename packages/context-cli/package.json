{
  "name": "@c4a/context-cli",
  "description": "Local runtime and Agent integration for traceable knowledge production",
  "version": "0.7.5",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/context4ai/context.git",
    "directory": "packages/context-cli"
  },
  "keywords": [
    "cli",
    "knowledge",
    "context",
    "claude-code",
    "claude-plugin"
  ],
  "main": "./dist/cli.js",
  "c4aBuild": {
    "assets": [
      "extract-wasm"
    ]
  },
  "bin": {
    "context": "dist/cli.js"
  },
  "files": [
    "dist",
    "scripts/postinstall.mjs",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "build": "rm -rf dist && bun run ../build.ts src/cli.ts --shebang=node && bun run scripts/build-workflow.ts && bun run scripts/build-plugin.ts && bun run scripts/build-indexers.ts && cp ../../LICENSE dist/LICENSE",
    "build:indexers": "bun run scripts/build-indexers.ts",
    "build:workflow": "bun run scripts/build-workflow.ts",
    "build:plugin": "bun run scripts/build-plugin.ts",
    "postinstall": "node scripts/postinstall.mjs",
    "typecheck": "tsc --noEmit",
    "test": "CONTEXT_RUNTIME_EVENTS_DISABLED=1 bun run scripts/run-unit-tests.mjs --max-concurrency=1 --timeout=120000",
    "lint": "eslint src",
    "clean-cache": "bun run src/cli.ts clean-cache"
  },
  "dependencies": {
    "@c4a/agent-graph": "0.3.0",
    "@c4a/context": "workspace:*",
    "@c4a/extract": "workspace:*",
    "@c4a/extract-contract": "workspace:*",
    "@c4a/extract-go": "workspace:*",
    "@c4a/extract-mdx": "workspace:*",
    "@c4a/extract-proto": "workspace:*",
    "@c4a/extract-rush": "workspace:*",
    "@c4a/extract-sql": "workspace:*",
    "@c4a/extract-style": "workspace:*",
    "@c4a/extract-thrift": "workspace:*",
    "@c4a/extract-ts": "workspace:*",
    "commander": "^11.0.0",
    "fast-xml-parser": "^5.10.1",
    "handlebars": "^4.7.8",
    "ink": "^5.0.0",
    "jiti": "^2.7.0",
    "mdast-util-to-string": "^4.0.0",
    "react": "^19.2.8",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "sharp": "^0.35.3",
    "typescript": "^5.5.4",
    "unified": "^11.0.5",
    "web-tree-sitter": "^0.20.8",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@c4a/core": "workspace:*"
  }
}
