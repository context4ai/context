{
  "name": "@c4a/extract-ts",
  "description": "TypeScript extraction plugin for C4A ExtractionResult v2",
  "version": "0.6.6",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/context4ai/context.git",
    "directory": "packages/extract-ts"
  },
  "main": "./dist/index.js",
  "c4aBuild": {
    "assets": [
      "extract-wasm"
    ]
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "rm -rf dist && bun run ../build.ts src/index.ts && bun run ../writeLibraryDistPackage.ts . && cp ../../LICENSE dist/LICENSE",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "eslint src"
  },
  "dependencies": {
    "typescript": "^5.5.4",
    "web-tree-sitter": "^0.20.8"
  },
  "devDependencies": {
    "@c4a/extract": "workspace:*"
  }
}
